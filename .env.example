# Facultatif : jeton Genius utilisé en secours si la recherche par paroles échoue.
# Compte gratuit puis https://genius.com/api-clients -> "Generate Access Token"
GENIUS_ACCESS_TOKEN=
PORT=3000
# Dossier où sont gardés les comptes (par défaut : ./data)
# DATA_DIR=./data
# Mets 1 si le site est derrière un proxy/hébergeur qui ajoute l'en-tête X-Forwarded-For
# TRUST_PROXY=1
# Recommandé en ligne (Render...) : comptes gardés dans Supabase au lieu de data/db.json (voir README)
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_KEY=sb_secret_...
# Facultatif : lien direct vers le son sur Spotify (sinon on passe par song.link, puis par la recherche Spotify)
# Crée une appli gratuite sur https://developer.spotify.com/dashboard pour obtenir ces deux valeurs
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# Facultatif : ton identifiant sur le site, pour voir la fenêtre « Stats » (réservée à l'admin)
# ADMIN_USERNAME=
