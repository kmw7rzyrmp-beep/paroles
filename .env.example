# Facultatif : jeton Genius utilisé en secours si la recherche par paroles échoue.
# Compte gratuit puis https://genius.com/api-clients -> "Generate Access Token"
GENIUS_ACCESS_TOKEN=
PORT=3000
# Dossier où sont gardés les comptes (par défaut : ./data)
# DATA_DIR=./data
# Mets 1 si le site est derrière un proxy/hébergeur qui ajoute l'en-tête X-Forwarded-For
# TRUST_PROXY=1
